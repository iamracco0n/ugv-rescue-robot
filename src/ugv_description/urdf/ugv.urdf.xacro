<?xml version="1.0"?>
<robot name="ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 로봇 2대를 한 월드에 띄우기 위한 접두사.
       비워 두면 지금까지와 완전히 같은 이름이 나온다(1대 구성 그대로).
       'ugv1/' 처럼 주면 TF 프레임은 ugv1/base_footprint, gz 센서 토픽은
       /ugv1/scan 이 된다.

       gz 토픽을 반드시 명시해야 하는 이유: 상대 토픽(cmd_vel, odom)이
       모델 스코프가 아니라 루트로 해석된다(실측 gz topic -l 에서 /cmd_vel).
       접두사를 안 붙이면 두 로봇이 같은 /cmd_vel 을 받아 함께 움직인다. -->
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="P" value="$(arg prefix)"/>

  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="dark_gray"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1"/></material>

  <link name="${P}base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="${P}base_footprint"/>
    <child link="${P}base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="${P}base_link">
    <visual>
      <geometry><box size="0.50 0.34 0.14"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- collision 없음 — 의도적.
         이 로봇은 VelocityControl 로 속도를 직접 지정해 움직인다(기구학 구동,
         바퀴도 시각 전용). 그런데 gz-sim8 은 <kinematic> 태그를 읽지 않아서
         (libgz-sim8 에 해당 문자열 자체가 없음) 링크가 완전한 동역학 강체로
         취급된다. 중력까지 꺼둔 상태라 충돌 충격이 감쇠 없이 그대로 남아,
         한 번 부딪히면 영구히 회전·상승해 로봇이 공중에서 뒹군다.
         (실측: 벽/장애물 접촉 후 z=3.4m, roll 98°, pitch 83°)

         충돌체를 두어도 기구학 구동이라 어차피 로봇을 막아주지 못하고
         충격만 받는다. 장애물 회피는 전적으로 LiDAR + Nav2 코스트맵이 담당한다.
         GpuLidar 는 렌더링 기반이라 visual 을 보므로 감지에도 영향이 없다. -->
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.15"/>
    </inertial>
  </link>

  <!-- 이 로봇은 VelocityControl 플러그인으로 기구학적으로 구동한다(바퀴는 시각 전용).
       그래서 base_link 는 중력을 끈다.

       주의: 포탑·총열은 revolute 조인트로 연결된 **별도 강체**라 중력이 따로 적용된다.
       base 만 끄면 포탑 무게(1.2kg)가 모델 전체를 끌어내려 서서히 가라앉고,
       바닥에 닿는 순간 튕기는데 base 에는 중력이 없어 되돌아오지 못한다.
       → 로봇이 공중으로 날아가 뒤집힌다. 반드시 세 링크 모두 꺼야 한다. -->
  <gazebo reference="${P}base_link">
    <kinematic>true</kinematic>
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="${P}turret_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="${P}gun_link">
    <gravity>false</gravity>
  </gazebo>

  <!-- 매개변수 이름이 'side' 인 이유: 로봇 구분 접두사 P 와 헷갈리지 않게.
       예전엔 이 자리도 prefix 였다. -->
  <xacro:macro name="wheel" params="side x_reflect y_reflect">
    <link name="${P}${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="dark_gray"/>
      </visual>
    </link>

    <joint name="${P}${side}_wheel_joint" type="fixed">
      <parent link="${P}base_link"/>
      <child link="${P}${side}_wheel_link"/>
      <origin xyz="${0.20 * x_reflect} ${0.19 * y_reflect} -0.10" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="front_left" x_reflect="1" y_reflect="1" />
  <xacro:wheel side="front_right" x_reflect="1" y_reflect="-1" />
  <xacro:wheel side="mid_left" x_reflect="0" y_reflect="1" />
  <xacro:wheel side="mid_right" x_reflect="0" y_reflect="-1" />
  <xacro:wheel side="rear_left" x_reflect="-1" y_reflect="1" />
  <xacro:wheel side="rear_right" x_reflect="-1" y_reflect="-1" />

  <link name="${P}laser_frame">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="${P}base_link"/>
    <child link="${P}laser_frame"/>
    <origin xyz="0.245 0.0 0.08" rpy="0 0 3.14159265"/>
  </joint>

  <link name="${P}turret_link">
    <visual>
      <geometry><box size="0.06 0.12 0.30"/></geometry>
      <material name="silver"/>
    </visual>
    <!-- collision 없음 — base_link 주석 참조 (기구학 구동이라 충격만 받음) -->
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="turret_yaw_joint" type="revolute">
    <parent link="${P}base_link"/>
    <child link="${P}turret_link"/>
    <origin xyz="0 0 0.245" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="100" velocity="1.0"/>
  </joint>

  <link name="${P}gun_link">
    <visual>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.06"/></geometry>
      <material name="gray"/>
    </visual>
    <!-- collision 없음 — base_link 주석 참조 -->
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="turret_pitch_joint" type="revolute">
    <parent link="${P}turret_link"/>
    <child link="${P}gun_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.52" upper="0.52" effort="100" velocity="1.0"/>
  </joint>

  <link name="${P}camera_link">
    <visual>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="${P}gun_link"/>
    <child link="${P}camera_link"/>
    <origin xyz="0.06 0.0 0.01" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${P}joint_states</topic>
    </plugin>

    <!-- cmd_vel 과 odom 은 상대 토픽으로 두면 모델 스코프가 아니라 루트로
         해석된다(실측). 접두사를 안 붙이면 두 로봇이 같은 /cmd_vel 을 받아
         나란히 움직인다. 반드시 명시한다. -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/${P}cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>${P}odom</odom_frame>
      <robot_base_frame>${P}base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/${P}odom</odom_topic>
      <tf_topic>/model/${P}ugv/tf</tf_topic>
      <publish_tf>false</publish_tf>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>turret_yaw_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <topic>/${P}turret_yaw_cmd</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>turret_pitch_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <topic>/${P}turret_pitch_cmd</topic>
    </plugin>
  </gazebo>

  <gazebo reference="${P}laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/${P}scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>${P}laser_frame</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>25.0</max>
          <resolution>0.015000</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="${P}camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/${P}camera</topic>
      <!-- 포인트클라우드를 Nav2 장애물 입력으로 쓰려면 frame_id 가 TF 에
           있는 이름이어야 한다. 없으면 스코프명(ugv/base_footprint/...)이
           나가고 코스트맵이 변환을 못 해 통째로 버린다.
           (열화상도 같은 이유로 이미 지정돼 있다) -->
      <gz_frame_id>${P}camera_link</gz_frame_id>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>8.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ===== 열화상(Thermal) 카메라 =====
       RGBD 카메라와 동일 링크(camera_link)·동일 해상도·동일 FOV로 장착.
       → 열화상 픽셀(u,v)이 depth 픽셀(u,v)과 1:1 정렬되므로
         화재 blob 위치에서 depth를 그대로 조회해 거리 추정 가능.
       주의: thermal 센서는 ogre2 렌더 엔진에서만 동작 (월드 sensors 플러그인 render_engine=ogre2 필요).
       출력: /thermal/image_raw (16bit mono, 픽셀값 = 온도[K] / linear_resolution). -->
  <gazebo reference="${P}camera_link">
    <sensor name="thermal_camera" type="thermal">
      <pose>0 0 0 0 0 0</pose>
      <topic>/${P}thermal/image_raw</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>${P}camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>L16</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>12.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <plugin filename="gz-sim-thermal-sensor-system"
              name="gz::sim::systems::ThermalSensor">
        <min_temp>253.15</min_temp>       <!-- -20°C -->
        <max_temp>655.0</max_temp>        <!-- ~382°C (16bit×0.01 상한 655.35K) -->
        <resolution>0.01</resolution>     <!-- linear_resolution: 픽셀 1 = 0.01K -->
      </plugin>
    </sensor>
  </gazebo>
</robot>
